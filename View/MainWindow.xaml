<Window x:Class="RateXChange.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RateXChange"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:components="clr-namespace:RateXChange.View.Components"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <telerik:RadBusyIndicator IsBusy="{Binding IsLoading}"
                              BusyContent="{Binding LoadingMessage, FallbackValue='Загрузка данных...'}"
                              DisplayAfter="0:0:0.15">
        <Grid>
            <telerik:EventToCommandBehavior.EventBindings>
                <telerik:EventBinding EventName="Loaded"
                          Command="{Binding InitializeCommand}" />
            </telerik:EventToCommandBehavior.EventBindings>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <components:NavBarView Grid.Row="0" DataContext="{Binding NavBar}" />

            <Grid Grid.Row="1" Margin="10" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="180" MaxWidth="400" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <components:RatesGridView Grid.Column="0" />

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                <components:RatesChartView Grid.Column="2" />
            </Grid>

            <components:ErrorMessage Grid.Row="2" />
        </Grid>
    </telerik:RadBusyIndicator>
</Window>
